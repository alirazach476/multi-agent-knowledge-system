# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Chat model on Groq (free tier)
GROQ_MODEL=openai/gpt-oss-20b

# Local embeddings (no API key; downloaded on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding device: cuda | cpu | mps (default: auto-detect CUDA)
EMBED_DEVICE=cuda
